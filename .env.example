# Copy this file to .env and fill in your values. .env is git-ignored.

# Required. YouTube Data API v3 key from Google Cloud.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Optional. Free MongoDB connection string enables result caching (saves quota)
# and powers the findConsistentOutlierChannels tool.
# Example: mongodb+srv://user:pass@cluster0.abc.mongodb.net/youtube_niche_analysis
MDB_MCP_CONNECTION_STRING=
